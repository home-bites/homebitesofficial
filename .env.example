# Copy this file to `.env` and fill in the values. Never commit `.env`.
#
# Firebase Console -> Project settings -> Your apps -> Add app -> Web (</>)
# These values are public by design: they ship inside the JS bundle.
# Firestore security rules are what actually protect your data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=homebites-production-56afa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=homebites-production-56afa
VITE_FIREBASE_STORAGE_BUCKET=homebites-production-56afa.firebasestorage.app
VITE_FIREBASE_SENDER_ID=552260980743
VITE_FIREBASE_APP_ID=

# Razorpay Dashboard -> Account & Settings -> API Keys
# Use the KEY ID only (rzp_live_... or rzp_test_... while testing).
# The KEY SECRET must never appear here — it belongs in the Cloud Function
# config only (`firebase functions:config:set razorpay.secret="..."`).
VITE_RAZORPAY_KEY_ID=

# Flat delivery fee in rupees. Set to 0 for free delivery.
VITE_DELIVERY_FEE=30

# --- Delivery area -----------------------------------------------------
# City name shown in customer-facing copy.
VITE_SERVICE_CITY=Guntur

# Comma-separated pincodes you deliver to. Leave blank to use the built-in
# Guntur city list in src/lib/serviceArea.js. VERIFY BEFORE GOING LIVE —
# this decides who can and cannot place an order.
VITE_ALLOWED_PINCODES=

# Fallback radius (km) from Guntur centre, used only when the `serviceAreas`
# collection is empty or unreachable.
VITE_SERVICE_RADIUS_KM=15

# --- Google Maps -------------------------------------------------------
# Browser key for the Maps JavaScript API (checkout pin picker).
# Public by design — restrict it by HTTP referrer in Google Cloud Console
# and cap the daily quota, or anyone can spend your Maps budget.
VITE_GOOGLE_MAPS_KEY=

# --- Firebase App Check (reCAPTCHA v3) ---------------------------------
# Optional. Leave blank and App Check stays off.
#
# This must be the site key Firebase Console -> App Check gives you when you
# register this web app — NOT a key from the standalone reCAPTCHA admin
# console. They look identical and are not interchangeable: App Check keys are
# bound to your Firebase project.
#
# Public by design; it ships in the browser bundle. The matching secret is held
# by Google and is never needed in this repo — if you find yourself pasting a
# reCAPTCHA *secret* anywhere under official_page/, something has gone wrong.
#
# The admin dashboard already reads this same variable name and initialises
# App Check when it is present.
VITE_RECAPTCHA_SITE_KEY=6LdNz4ctAAAAALl-j2mO5TPsOj4TP186uBqCaSM4
